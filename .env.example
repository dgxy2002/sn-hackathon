# Docker Compose host ports
WEB_PORT=4173
API_PORT=8000

# Private document processing limits and transient retention.
ANALYSIS_TTL_HOURS=24
DOCUMENT_MAX_SIZE_BYTES=20971520
DOCUMENT_MAX_PAGE_COUNT=100
DOCUMENT_ORPHAN_TTL_MINUTES=30

# Local-only PostgreSQL bootstrap values used by the evidence store.
# Do not reuse these values outside local development.
POSTGRES_DB=before_you_commit
POSTGRES_USER=before_you_commit
POSTGRES_PASSWORD=local-only

# Optional grounded rendering provider. The active local workflow remains
# credential-free when these values or credentials are absent.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Local live-mode credentials are read by boto3's standard credential chain.
# Leave these empty for local-only processing. ECS deployments use a task role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional corporate TLS interception CA bundle. When required, build with:
# docker compose -f compose.yaml -f compose.corporate-ca.yaml up --build -d
CORPORATE_CA_CERT_PATH=