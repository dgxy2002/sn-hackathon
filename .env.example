# Docker Compose host ports
WEB_PORT=4173
API_PORT=8000

# Local-only PostgreSQL bootstrap values used by the cached evidence adapter.
# Do not reuse these values outside local development.
POSTGRES_DB=covercheck
POSTGRES_USER=covercheck
POSTGRES_PASSWORD=covercheck-local-only

# Set EVIDENCE_MODE=live to query Supabase pgvector with Bedrock embeddings.
EVIDENCE_MODE=cached
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

# E11 grounded explanation and conversational answer provider. Simulated modes
# keep the credential-free fixture paths; set either mode to live for Bedrock.
ORCHESTRATION_MODE=simulated
CONVERSATION_MODE=simulated
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Local live-mode credentials are read by boto3's standard credential chain.
# Leave these empty for fixture mode. ECS deployments use a task role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional corporate TLS interception CA bundle. When required, build with:
# docker compose -f compose.yaml -f compose.corporate-ca.yaml up --build -d
CORPORATE_CA_CERT_PATH=
