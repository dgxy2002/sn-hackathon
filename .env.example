# Docker Compose host ports
WEB_PORT=4173
API_PORT=8000

# Local-only PostgreSQL bootstrap values used by the cached evidence adapter.
# Do not reuse these values outside local development.
POSTGRES_DB=covercheck
POSTGRES_USER=covercheck
POSTGRES_PASSWORD=covercheck-local-only

# E11 grounded explanation provider. ORCHESTRATION_MODE=simulated keeps the
# credential-free fixture path; set it to live to call Bedrock.
ORCHESTRATION_MODE=simulated
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Local live-mode credentials are read by boto3's standard credential chain.
# Leave these empty for fixture mode. ECS deployments use a task role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional corporate TLS interception CA bundle. When required, build with:
# docker compose -f compose.yaml -f compose.corporate-ca.yaml up --build -d
CORPORATE_CA_CERT_PATH=