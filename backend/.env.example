# Runtime
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Capability modes: live, cached, synthetic, or simulated
PROFILE_MODE=synthetic
EXTRACTION_MODE=simulated
EVIDENCE_MODE=cached
RECOMMENDATION_MODE=simulated
ORCHESTRATION_MODE=simulated
CONVERSATION_MODE=simulated

# Read-only evidence retrieval. The default corpus is committed with the repo.
EVIDENCE_CORPUS_PATH=
EVIDENCE_MAX_AGE_DAYS=365
DEPENDENCY_TIMEOUT_SECONDS=20

# Required only when EVIDENCE_MODE=live. Query embeddings use Bedrock through
# boto3's standard AWS credential chain.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

# Required only by the offline OpenAI brochure-extraction utility.
OPENAI_KEY=

# Local state services (not required for the initial fixture API)
DATABASE_URL=
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_BUCKET=
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=

# OpenRouter remains the E04 document-extraction provider.
OPENROUTER_API_KEY=
# Exact slug remains intentionally blank until DEC-002 is resolved.
OPENROUTER_MODEL=
DOCUMENT_AI_PROVIDER=fixture

# Amazon Bedrock is the required E11 explanation provider. Local fixture mode
# needs no AWS credential. Live mode uses the standard boto3 credential chain
# locally and an ECS task role in AWS; never commit access keys.
LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Bounded runtime defaults
AGENT_MAX_ACTIONS=6
CONVERSATION_MAX_TURNS=12
SUMMARY_REVISION_LIMIT=5
SCRAPE_INTERVAL_SECONDS=86400
SCRAPE_LEASE_TTL_SECONDS=900
SCRAPE_SOURCE_ALLOWLIST=
SCRAPE_TIMEOUT_SECONDS=20
SCRAPE_DELAY_SECONDS=1
SCRAPE_MAX_RETRIES=3
