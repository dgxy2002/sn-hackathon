# Runtime
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Private document processing limits and transient retention.
ANALYSIS_TTL_HOURS=24
DOCUMENT_MAX_SIZE_BYTES=20971520
DOCUMENT_MAX_PAGE_COUNT=100
DOCUMENT_ORPHAN_TTL_MINUTES=30
DOCUMENT_WORKSPACE_ROOT=

# Optional local state service.
DATABASE_URL=

# Optional grounded rendering provider. Local parsing, privacy detection,
# extraction, indexing, and search must work without model access.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Allowlisted official-guidance worker.
SCRAPE_INTERVAL_SECONDS=86400
SCRAPE_LEASE_TTL_SECONDS=900
SCRAPE_SOURCE_ALLOWLIST=
SCRAPE_TIMEOUT_SECONDS=20
SCRAPE_DELAY_SECONDS=1
SCRAPE_MAX_RETRIES=3